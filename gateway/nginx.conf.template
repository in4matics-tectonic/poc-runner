# Showcase page. /config.js tells the page where the parts run: on subdomains of POC_DOMAIN (VM),
# or else on these ports of the host the page was opened on (local).
server {
  listen 80;
  root /usr/share/nginx/html;

  location = /config.js {
    default_type application/javascript;
    add_header Cache-Control no-store;
    return 200 'window.POC = { domain: "${POC_DOMAIN}", ports: { app: ${APP_PORT}, backoffice: ${BACKOFFICE_PORT}, chat: ${CHAT_PORT}, backend: ${BACKEND_PORT} } };';
  }

  # Health probes for the status dots, same-origin so the page can read the real result.
  # Resolved per request so the gateway starts even when a service is down.
  resolver 127.0.0.11 valid=5s ipv6=off;
  location = /status/backend { set $u http://backend:3000/health; proxy_pass $u; proxy_connect_timeout 2s; }
  location = /status/mcp     { set $u http://backend:3001/health; proxy_pass $u; proxy_connect_timeout 2s; }
  location = /status/chat    { set $u http://chat:3000/health;    proxy_pass $u; proxy_connect_timeout 2s; }
  location = /status/app        { set $u http://app/;        proxy_pass $u; proxy_connect_timeout 2s; }
  location = /status/backoffice { set $u http://backoffice/; proxy_pass $u; proxy_connect_timeout 2s; }

  # "Reset" button: the page logs in as adviseur and resets the backend's demo state, then clears the chats
  location = /reset/login   { set $u http://backend:3000/v1/auth/login; proxy_pass $u; proxy_connect_timeout 2s; }
  location = /reset/backend { set $u http://backend:3000/v1/demo/reset; proxy_pass $u; proxy_connect_timeout 2s; }
  location = /reset/chat    { set $u http://chat:3000/admin/reset;       proxy_pass $u; proxy_connect_timeout 2s; }

  location / {
    add_header Cache-Control no-cache;
    try_files $uri /index.html;
  }
}
