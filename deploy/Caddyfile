# Public entry point on the VM: HTTPS for the showcase and one subdomain per part, all behind the shared password.
# POC_DOMAIN is e.g. 34-75-1-2.sslip.io (or your own domain with a wildcard DNS record).

(gate) {
	forward_auth gate:3000 {
		uri /verify
	}
}

{$POC_DOMAIN} {
	handle /__login {
		reverse_proxy gate:3000
	}
	handle {
		import gate
		reverse_proxy gateway:80
	}
}

app.{$POC_DOMAIN} {
	import gate
	reverse_proxy app:80
}

backoffice.{$POC_DOMAIN} {
	import gate
	reverse_proxy backoffice:80
}

chat.{$POC_DOMAIN} {
	import gate
	reverse_proxy chat:3000
}

api.{$POC_DOMAIN} {
	import gate
	reverse_proxy backend:3000
}
