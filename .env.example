# Copy to .env (./run.sh does this for you and fills in random secrets). Never commit .env.

# Backend secret. (The demo users' password is fixed in docker-compose.yml: in4matics-must-win)
JWT_SECRET=

# Needed for the chat panel (the customer's own AI). Without it the chat shows a notice.
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-opus-5-5
# CHAT_EFFORT=low

# Build sources. Default: the GitHub repos (main branch). Use a local checkout to test uncommitted work:
# BACKEND_SRC=../backend
# MCP_SRC=../mcp
# BACKOFFICE_SRC=../backoffice
# APP_SRC=../mobile-app
# Or another branch / tag / commit: https://github.com/in4matics-tectonic/backend.git#my-branch

# Host ports
# GATEWAY_PORT=7000
# APP_PORT=7001
# BACKOFFICE_PORT=7002
# CHAT_PORT=7003
# BACKEND_PORT=7004
